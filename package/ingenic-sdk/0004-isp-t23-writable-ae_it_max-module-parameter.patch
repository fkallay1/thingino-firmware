From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fedor Kallay <fkallay1@gmail.com>
Date: Sat, 10 Oct 2026 12:18:00 +0200
Subject: [PATCH] isp: t23: writable ae_it_max module parameter

Since ISP firmware 1.1.2 the vendor core has tisp_ae_min_max_set() as an
empty stub, so IMP_ISP_Tuning_SetAe_IT_MAX() has no effect on T23. The AE
algorithm still takes the maximum integration time from ae_exp_th[0] when
ae_extra_at_list_wdr[4] is set. Expose it as a module parameter.
---
 common/isp/t23/Kbuild             |  3 +-
 common/isp/t23/tx-isp-ae-limits.c | 65 +++++++++++++++++++++++++++++++
 2 files changed, 67 insertions(+), 1 deletion(-)
 create mode 100644 common/isp/t23/tx-isp-ae-limits.c

diff --git a/common/isp/t23/Kbuild b/common/isp/t23/Kbuild
index a9c0f06..84d6305 100644
--- a/common/isp/t23/Kbuild
+++ b/common/isp/t23/Kbuild
@@ -2,7 +2,8 @@ ISP_FW_VER=1.3.0
 COMPILER_VER=540
 
 SRCS := $(DIR)/tx-isp-debug.c \
-	$(DIR)/tx-isp-module.c
+	$(DIR)/tx-isp-module.c \
+	$(DIR)/tx-isp-ae-limits.c
 
 ifdef SENSOR_REGISTRY_IN_SDK
     SRCS += common/isp/common/tx-isp-sinfo.c
diff --git a/common/isp/t23/tx-isp-ae-limits.c b/common/isp/t23/tx-isp-ae-limits.c
new file mode 100644
index 0000000..46e8214
--- /dev/null
+++ b/common/isp/t23/tx-isp-ae-limits.c
@@ -0,0 +1,65 @@
+/*
+ * AE integration time limit for the T23 ISP core.
+ *
+ * Since ISP firmware 1.1.2 the vendor core ships tisp_ae_min_max_set() as an
+ * empty stub, so IMP_ISP_Tuning_SetAe_IT_MAX() is accepted and silently
+ * ignored. The AE algorithm itself still honours a limit: on every refresh
+ * tisp_ae0_ctrls_update() takes the maximum integration time from
+ * ae_exp_th[0] when ae_extra_at_list_wdr[4] is set, the same way the working
+ * max again / max isp dgain setters do it.
+ *
+ * Expose that limit as a writable module parameter, in sensor lines:
+ *   echo 337 > /sys/module/tx_isp_t23/parameters/ae_it_max
+ * 0 hands the limit back to the sensor default.
+ */
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/irqflags.h>
+
+#define AE_TH_IT_MAX		0
+#define AE_TH_ISP_DGAIN_MAX	3
+#define AE_AT_IT_MAX		4
+#define AE_AT_ISP_DGAIN_MAX	7
+
+extern unsigned int ae_exp_th[20];
+extern unsigned int ae_extra_at_list_wdr[10];
+extern int tiziano_ae_s_max_isp_dgain(void *core, unsigned int dgain);
+
+static unsigned int ae_it_max;
+
+static int ae_it_max_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int lines, at, th;
+	unsigned long flags;
+	int ret;
+
+	ret = kstrtouint(val, 0, &lines);
+	if (ret)
+		return ret;
+
+	local_irq_save(flags);
+	ae_exp_th[AE_TH_IT_MAX] = lines;
+	ae_extra_at_list_wdr[AE_AT_IT_MAX] = lines ? 1 : 0;
+	/*
+	 * The refresh request flag is private to the core. The max isp dgain
+	 * setter raises it and touches nothing but its own two slots, so call
+	 * it and put those slots back.
+	 */
+	at = ae_extra_at_list_wdr[AE_AT_ISP_DGAIN_MAX];
+	th = ae_exp_th[AE_TH_ISP_DGAIN_MAX];
+	tiziano_ae_s_max_isp_dgain(NULL, 0);
+	ae_extra_at_list_wdr[AE_AT_ISP_DGAIN_MAX] = at;
+	ae_exp_th[AE_TH_ISP_DGAIN_MAX] = th;
+	local_irq_restore(flags);
+
+	ae_it_max = lines;
+	return 0;
+}
+
+static const struct kernel_param_ops ae_it_max_ops = {
+	.set = ae_it_max_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(ae_it_max, &ae_it_max_ops, &ae_it_max, S_IRUGO | S_IWUSR);
+MODULE_PARM_DESC(ae_it_max, "AE maximum integration time in sensor lines, 0 = sensor default");
-- 
2.53.0.windows.3

